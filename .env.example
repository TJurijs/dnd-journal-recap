# Required
DISCORD_BOT_TOKEN=your_discord_bot_token_here
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional — sane defaults provided
# Per-step models live in models.yaml. GEMINI_MODEL is only the fallback when
# a step is missing from models.yaml.
GEMINI_MODEL=gemini-3-flash-preview
LOG_LEVEL=INFO
DATA_DIR=/data
MAX_VOD_HOURS=6
# Available styles: chapters (default), bullets, narrative, structured, terse.
DEFAULT_STYLE=chapters
DOWNLOAD_RATE_LIMIT=
FFMPEG_BIN=ffmpeg

# Discord-specific (optional) — set for instant guild-scoped command sync
# during dev. Leave empty in prod for global sync.
DISCORD_GUILD_ID=
